{
  "name": "gym-tracker-frontend",
  "version": "0.0.1",
  "description": "LiftUp Precision Gym OS",
  "productName": "LiftUp",
  "author": "Kevin <ultrakevin143@example.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "lint:check": "prettier --check \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "dev": "quasar dev",
    "predev": "node scripts/prepare-workout-assets.mjs && node scripts/prepare-pose-assets.mjs",
    "dev:all": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev\"",
    "dev:api": "npm --prefix ../backend-express run dev",
    "build": "quasar build",
    "prebuild": "node scripts/prepare-workout-assets.mjs && node scripts/prepare-pose-assets.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@bryllim/workout-guide": "^1.0.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "@quasar/extras": "^2.0.4",
    "axios": "^1.20.0",
    "pinia": "^4.0.2",
    "quasar": "^2.29.0",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.8.1",
    "@types/node": "^22.19.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
